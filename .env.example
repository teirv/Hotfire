# Your image on GitHub. Use lowercase.
HOTFIRE_IMAGE=ghcr.io/YOUR-GITHUB-NAME/hotfire:latest

# Paste the result of: openssl rand -hex 32
SECRET_KEY=change-me

# The address people will use.
PUBLIC_URL=https://hotfire.valentine-server.com

# Keep this true when you reach Hotfire through https. Set to false only to test on your home network with http.
COOKIE_SECURE=true

# Optional: lets Claude explain mistakes. Leave blank to use the built-in explanations.
ANTHROPIC_API_KEY=
EXPLAIN_DAILY_LIMIT=30
